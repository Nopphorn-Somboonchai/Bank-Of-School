rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. ฟังก์ชันตรวจสอบการเข้าสู่ระบบทั่วไป (Authentication Check)
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. ฟังก์ชันตรวจสอบสิทธิ์ความเป็นครู (Teacher Role Check)
    // เช็คว่ามีเอกสารข้อมูลครูอยู่ในระบบภายใต้ appId (โรงเรียน) นั้น ๆ หรือไม่
    function isTeacher(appId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.status != 'Suspended';
    }

    // 3. ฟังก์ชันตรวจสอบสิทธิ์ผู้ดูแลระบบ (Admin Check)
    function isAdmin(appId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.status != 'Suspended' &&
        (
          get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.role == 'Admin' ||
          get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.role == 'Super Admin'
        );
    }

    // 4. ฟังก์ชันตรวจสอบการมีอยู่ของเอกสาร Placeholder สำหรับครู/เจ้าหน้าที่ (ตาม D1)
    function hasStaffPlaceholder(appId, email) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/users/$('STAFF_' + email.lower()));
    }

    // 5. ฟังก์ชันดึงข้อมูลเอกสาร Placeholder
    function getStaffPlaceholder(appId, email) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/users/$('STAFF_' + email.lower()));
    }

    // 6. ฟังก์ชันตรวจสอบความถูกต้องของข้อมูลสรุปแดชบอร์ด (Dashboard Summary Validation)
    function isValidDashboardSummary() {
      return request.resource.data.keys().hasOnly([
        'totalSavings', 'totalStudents', 'totalAccounts',
        'activeStudents', 'activeAccounts', 'todayDeposits',
        'todayWithdrawals', 'dailyStats', 'lastUpdated', 'currentDate'
      ]) &&
      (!('totalSavings' in request.resource.data) || (request.resource.data.totalSavings is number && request.resource.data.totalSavings >= 0)) &&
      (!('totalStudents' in request.resource.data) || (request.resource.data.totalStudents is number && request.resource.data.totalStudents >= 0)) &&
      (!('totalAccounts' in request.resource.data) || (request.resource.data.totalAccounts is number && request.resource.data.totalAccounts >= 0)) &&
      (!('activeStudents' in request.resource.data) || (request.resource.data.activeStudents is number && request.resource.data.activeStudents >= 0)) &&
      (!('activeAccounts' in request.resource.data) || (request.resource.data.activeAccounts is number && request.resource.data.activeAccounts >= 0)) &&
      (!('todayDeposits' in request.resource.data) || (request.resource.data.todayDeposits is number && request.resource.data.todayDeposits >= 0)) &&
      (!('todayWithdrawals' in request.resource.data) || (request.resource.data.todayWithdrawals is number && request.resource.data.todayWithdrawals >= 0));
    }

    // Fallback: ปิดกั้นการเข้าถึงที่ไม่ได้ระบุไว้ในเงื่อนไขอย่างชัดเจน (ป้องกันบุคคลภายนอกเข้าถึงข้อมูลทุกส่วน)
    match /{document=**} {
      allow read, write: if false;
    }

    // กฎการเข้าถึงข้อมูลตามโครงการ Bank of School (Multi-tenant โดยใช้ appId)
    match /artifacts/{appId} {
      
      // ==========================================
      // 1. ข้อมูลคุณครู / เจ้าหน้าที่ระบบ (Users)
      match /users/{userId} {
        // อนุญาตให้อ่านข้อมูลครูคนอื่นในโรงเรียนเดียวกันได้ หรืออ่านข้อมูลตัวเอง หรือเอกสารชั่วคราวที่มีอีเมลตรงกับตนเอง
        allow read: if isAuthenticated() && (
          request.auth.uid == userId || 
          isTeacher(appId) || 
          (request.auth.token.email != null && userId == 'STAFF_' + request.auth.token.email.lower()) ||
          (resource != null && resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        );
        // อนุญาตให้คุณครูสร้างข้อมูลตัวเองได้ตอนสมัครใช้งานครั้งแรก หรือโดย Admin
        // ป้องกัน Privilege Escalation (D1): role/status ต้องตรงกับ placeholder หรือเป็น role ต่ำสุด (Teacher, Active)
        allow create: if isAuthenticated() && (
          isAdmin(appId) || 
          (
            request.auth.uid == userId && 
            request.auth.token.email != null &&
            request.resource.data.email != null &&
            request.resource.data.email.lower() == request.auth.token.email.lower() &&
            (
              (
                hasStaffPlaceholder(appId, request.auth.token.email) &&
                request.resource.data.role == getStaffPlaceholder(appId, request.auth.token.email).data.role &&
                request.resource.data.status == getStaffPlaceholder(appId, request.auth.token.email).data.status
              ) ||
              (
                !hasStaffPlaceholder(appId, request.auth.token.email) &&
                (
                  (request.auth.token.email.lower().matches('^admin@.*') && (request.resource.data.role == 'Admin' || request.resource.data.role == 'Super Admin')) ||
                  (request.resource.data.role == 'Teacher')
                ) &&
                request.resource.data.status == 'Active'
              )
            )
          )
        );
        // อนุญาตให้แก้ไขข้อมูลเฉพาะของตัวเอง หรือโดย Admin
        allow update: if isAuthenticated() && (
          isAdmin(appId) || 
          (
            request.auth.uid == userId && 
            request.resource.data.role == resource.data.role && 
            request.resource.data.status == resource.data.status
          )
        );
        // อนุญาตให้ลบข้อมูลโดย Admin หรือลบ temporary placeholder ของตนเอง (STAFF_* ที่มีอีเมลตรงกัน) เท่านั้น
        allow delete: if isAuthenticated() && (
          isAdmin(appId) || 
          (
            userId.matches('^STAFF_.*') && 
            request.auth.token.email != null && 
            (
              userId == 'STAFF_' + request.auth.token.email.lower() ||
              (resource != null && resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
            )
          )
        );
      }
      
      // ==========================================
      // 2. ข้อมูลโปรไฟล์นักเรียน (Students)
      // ==========================================
      match /students/{studentId} {
        // นโยบาย No-Delete: อนุญาตให้ครู อ่าน สร้าง และแก้ไขข้อมูลนักเรียนได้เท่านั้น (ห้ามลบเด็ดขาด)
        allow read, create, update: if isTeacher(appId);
        allow delete: if false;
      }
      
      // ==========================================
      // 3. บัญชีเงินฝากนักเรียน (Accounts)
      // ==========================================
      match /accounts/{accountId} {
        allow read: if isTeacher(appId);
        // นโยบาย No-Delete และป้องกันยอดเงินคงเหลือติดลบจากฝั่งเซิร์ฟเวอร์ (currentBalance >= 0)
        allow create, update: if isTeacher(appId) && 
          request.resource.data.currentBalance >= 0;
        allow delete: if false;
      }
      
      // ==========================================
      // 4. รายการธุรกรรมการเงิน (Transactions)
      // ==========================================
      match /transactions/{transactionId} {
        // นโยบาย Append-only: คุณครูสามารถดูลายรายการธุรกรรม (Read) และบันทึกธุรกรรมใหม่ (Create) ได้เท่านั้น (ห้ามแก้ไขและห้ามลบเด็ดขาด)
        // และป้องกันยอดเงินติดลบของรายการย้อนหลังจากฝั่งเซิร์ฟเวอร์ (balanceAfter >= 0)
        allow read: if isTeacher(appId);
        allow create: if isTeacher(appId) && 
          request.resource.data.amount > 0 && 
          request.resource.data.balanceAfter >= 0;
        allow update, delete: if false;
        
        
      }
      
      // ==========================================
      // 5. บันทึกประวัติการใช้งานระบบ (Audit Logs)
      // ==========================================
      match /audit_logs/{logId} {
        // นโยบาย Append-only: อนุญาตให้คุณครูอ่านและบันทึกประวัติการใช้งานระบบได้เท่านั้น (ห้ามแก้ไขหรือลบเด็ดขาด)
        allow read, create: if isTeacher(appId);
        allow update, delete: if false;
      }
      
      // ==========================================
      // 6. การตั้งค่าระบบ (Settings)
      // ==========================================
      match /settings/system_config {
        // คุณครูสามารถอ่านการตั้งค่าเพื่อดูชื่อโรงเรียน/ปีการศึกษาได้ แต่เฉพาะ Admin เท่านั้นที่แก้ไขได้
        allow read: if isTeacher(appId);
        allow write: if isAdmin(appId);
      }
      
      match /settings/dashboard_summary {
        // คุณครูสามารถอ่านข้อมูลสรุปแดชบอร์ดได้
        // การเขียนจำกัดเฉพาะฟิลด์ที่ได้รับอนุญาต และต้องมีค่าตัวเลข >= 0
        allow read: if isTeacher(appId);
        allow create, update: if isAdmin(appId) || (isTeacher(appId) && isValidDashboardSummary());
        allow delete: if isAdmin(appId);
      }

      match /settings/{settingId} {
        // กฎทั่วไปสำหรับการตั้งค่าอื่นๆ (ถ้ามี)
        allow read, write: if isAdmin(appId);
      }
      
      // ==========================================
      // 7. รายงานผลสรุปการเงิน (Reports)
      // ==========================================
      match /reports/{reportId} {
        // คุณครูเท่านั้นที่สามารถเข้าถึงรายงานได้
        allow read, write: if isTeacher(appId);
      }
      
      // ==========================================
      // 8. ตัวนับรหัสรันนิ่งอ้างอิงธุรกรรม (Counter)
      // ==========================================
      match /counter/{counterId} {
        // คุณครูเท่านั้นที่ดึงและเพิ่มยอดตัวนับได้
        allow read, write: if isTeacher(appId);
      }
    }
  }
}